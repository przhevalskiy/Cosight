# ===========================================
# CoSight Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-sonnet-4-6

# Mistral (optional fallback)
MISTRAL_API_KEY=your-mistral-key
MISTRAL_MODEL=mistral-large-latest

# Google Analytics 4 + Search Console (service account JSON as a single line)
GOOGLE_CREDENTIALS_JSON=
# Or path to the JSON key file:
# GOOGLE_CREDENTIALS_FILE=/path/to/service-account.json
GA4_PROPERTY_ID=288367390
GSC_SITE_URL=https://business.columbia.edu/

# Emma
EMMA_PUBLIC_KEY=
EMMA_PRIVATE_KEY=
EMMA_ACCOUNT_ID=

# Sprout Social
SPROUT_API_TOKEN=
SPROUT_CBS_GROUP_IDS=2415696,2468619,2551611
SPROUT_DATA_LAG_DAYS=2

# Application
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true
LOG_LEVEL=INFO
